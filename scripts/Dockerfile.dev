FROM python:3.11-slim

# Install deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    # Common tools  \
    make git tmux curl pandoc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for locked dependency exports.
RUN pip install --no-cache-dir uv

# Set the working directory
WORKDIR /app

# Copy only the files needed for installation
COPY pyproject.toml uv.lock ./

# Install project dependencies into the system interpreter used by the entrypoint.
RUN uv export --frozen --no-hashes --no-emit-project --extra server --extra browser --extra datascience -o requirements.txt \
    && pip install --no-cache-dir -r requirements.txt

# Copy the project files
COPY . /app

# Entrypoint if prompt/args given, run the CLI
ENTRYPOINT ["python", "-m", "gptme"]
