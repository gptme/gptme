{
  "name": "gptme-site-next",
  "private": true,
  "version": "0.0.0",
  "description": "gptme.org open-source showcase site (design v3)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/readme.test.ts src/lib/readme-hash.test.ts",
    "build": "node scripts/copy-assets.mjs && npm test && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "github-slugger": "2.0.0",
    "marked": "18.0.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "10.6.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
